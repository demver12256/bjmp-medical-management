{{> head }}
<body class="bg-[#0b132b] text-slate-100 min-h-screen flex flex-col selection:bg-emerald-600 selection:text-white">

  {{> navbar }}

  <!-- ============================================================ -->
  <!-- NURSE DEDICATED WORKSPACE (/nurse)                           -->
  <!-- ============================================================ -->
  <main id="mainAppContainer" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Nurse Role Banner -->
    <div class="mb-6 p-4 rounded-2xl bg-gradient-to-r from-emerald-950/70 via-slate-900/80 to-slate-900/80 border border-emerald-500/30 flex flex-wrap items-center justify-between gap-4 no-print">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-emerald-600/20 border border-emerald-500/40 flex items-center justify-center text-2xl">
          📋
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white">Nurse Triage Intake & Pharmacy Dispensing Station</h2>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Nurse Role</span>
          </div>
          <p class="text-xs text-slate-400">Register newly admitted PDLs, log preliminary triage vitals, record recovery observations, and dispense physician prescriptions.</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="openRegisterPdlModal()" class="px-4 py-2 text-xs font-bold rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/30 transition-all flex items-center gap-1.5">
          <span>+</span> Register New PDL
        </button>
      </div>
    </div>

    <!-- Nurse Stat Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 no-print">
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Registered PDLs</div>
        <div id="statNurseTotalPdls" class="text-2xl font-black text-white mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Active medical records</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Awaiting Triage / Exam</div>
        <div id="statDocPending" class="text-2xl font-black text-amber-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">In clinical intake queue</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Pending Rx Dispense</div>
        <div id="statNursePendingRx" class="text-2xl font-black text-emerald-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Awaiting pharmacy release</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Custody Checkup Alerts</div>
        <div id="statDocRequests" class="text-2xl font-black text-blue-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">From Jail Officers</div>
      </div>
    </div>

    <!-- Nurse Internal Section Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-800 pb-3 mb-6 overflow-x-auto no-print">
      <button id="tabBtn_nurse" onclick="switchTab('nurse')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border flex items-center gap-2 transition-all bg-blue-600/30 text-blue-400 border-blue-500/50">
        <span>📋</span>
        <span>PDL Triage & Observation Registry</span>
      </button>

      <button id="tabBtn_prescriptions" onclick="switchTab('prescriptions')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>💊</span>
        <span>Pharmacy Rx Dispensing</span>
      </button>

      <button id="tabBtn_requests" onclick="switchTab('requests')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>📨</span>
        <span>Custody Checkup Requests</span>
      </button>

      <button id="tabBtn_telemetry" onclick="switchTab('telemetry')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>⚡</span>
        <span>Ward Vital Telemetry</span>
        <span id="alertCountBadge" class="hidden px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-red-600 text-white">0</span>
      </button>
    </div>

    <!-- SECTION 1: NURSE TRIAGE STATION & PDL REGISTRY -->
    <div id="tabPanel_nurse" class="space-y-6">
      <div class="glass-panel p-4 rounded-xl border border-slate-800 flex items-center gap-3">
        <span class="text-slate-400 text-sm">🔍</span>
        <input type="text" id="nurseSearchInput" oninput="fetchPdls(this.value)" placeholder="Search by booking code (e.g. BJMP-MNL-2026-0104) or full name..." class="flex-1 bg-transparent text-sm text-white placeholder-slate-500 focus:outline-none" />
        <button onclick="fetchPdls()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
          🔄 Refresh
        </button>
      </div>

      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Booking ID</th>
                <th class="px-5 py-3">Full Name</th>
                <th class="px-5 py-3">Cell / Assigned Facility</th>
                <th class="px-5 py-3">Case Status</th>
                <th class="px-5 py-3 text-right">Nurse Triage Actions</th>
              </tr>
            </thead>
            <tbody id="nurseRegistryTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading PDLs...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 2: PHARMACY RX DISPENSING -->
    <div id="tabPanel_prescriptions" class="space-y-6 hidden">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>💊</span>
              <span>Authorized Medication Prescriptions & Dispensing Log</span>
            </h3>
            <p class="text-xs text-slate-400">Verify doctor-authorized prescriptions and dispense medications to PDL patients.</p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Rx ID</th>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Prescribed Medications & Dosage</th>
                <th class="px-5 py-3">Authorized By</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Dispense Action</th>
              </tr>
            </thead>
            <tbody id="prescriptionsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="px-6 py-6 text-center text-slate-500">Loading prescriptions...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 3: CUSTODY CHECKUP REQUESTS -->
    <div id="tabPanel_requests" class="space-y-6 hidden">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800">
          <h3 class="text-base font-bold text-white">Custody Medical Checkup Requests</h3>
          <p class="text-xs text-slate-400">Requests submitted by Jail Officers for PDLs needing triage or checkup.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Reason for Request</th>
                <th class="px-5 py-3">Priority</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading requests...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 4: TELEMETRY -->
    {{> telemetry }}

  </main>

  <!-- MODAL: NURSE TRIAGE INTAKE -->
  <div id="triageModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <div>
          <h3 class="text-base font-bold text-white">Triage Intake Station</h3>
          <p class="text-xs text-slate-400">Log vital signs & initial symptoms</p>
        </div>
        <button onclick="closeTriageModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleTriageSubmit(event)" class="space-y-4">
        <input type="hidden" id="triageRecordId" />
        <div class="p-3 rounded-lg bg-slate-900 text-xs">
          <div class="font-bold text-white" id="triagePdlName">--</div>
          <div class="text-slate-400 font-mono" id="triagePdlNumber">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] text-slate-400">Blood Pressure</label>
            <input type="text" id="triageBp" required placeholder="120/80" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Heart Rate (bpm)</label>
            <input type="number" id="triageHr" required placeholder="75" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Temperature (°C)</label>
            <input type="number" step="0.1" id="triageTemp" required placeholder="36.8" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">SpO2 (%)</label>
            <input type="number" id="triageSpo2" required placeholder="98" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div class="col-span-2">
            <label class="text-[11px] text-slate-400">Respiratory Rate (cpm)</label>
            <input type="number" id="triageRr" required placeholder="18" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Preliminary Presenting Symptoms</label>
          <textarea id="triageSymptoms" rows="2" required placeholder="Describe complaints reported by patient during triage..." class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeTriageModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-emerald-600 hover:bg-emerald-500 text-white">Save Triage & Update Queue</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: REGISTER NEW PDL -->
  <div id="regPdlModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-xl w-full p-6 space-y-4 shadow-2xl my-8">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <div>
          <h3 class="text-base font-bold text-white">Register New Person Deprived of Liberty (PDL)</h3>
          <p class="text-xs text-slate-400">Creates booking record & initializes 1:1 Medical Record</p>
        </div>
        <button onclick="closeRegisterPdlModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleRegisterPdlSubmit(event)" class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] text-slate-400">Booking Number</label>
            <input type="text" id="regPdlNumber" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Full Name</label>
            <input type="text" id="regFullName" required placeholder="e.g. Manuel 'Manny' Reyes" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Date of Birth</label>
            <input type="date" id="regDob" required value="1985-05-10" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Admission Date</label>
            <input type="date" id="regAdmissionDate" required value="2026-10-30" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Assigned Facility</label>
            <select id="regFacility" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white">
              <option value="Manila City Jail Male Dormitory">Manila City Jail Male Dormitory</option>
              <option value="Quezon City Jail Male Dormitory">Quezon City Jail Male Dormitory</option>
              <option value="Pasig City Jail Male Dormitory">Pasig City Jail Male Dormitory</option>
            </select>
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Cell / Brigada Number</label>
            <input type="text" id="regCell" required placeholder="e.g. Brigada 3 - Cell 08" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Initial Medical History / Chronic Conditions</label>
          <textarea id="regHistory" rows="2" placeholder="Chronic ailments, surgeries, prior hospitalizations..." class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Known Drug Allergies</label>
          <input type="text" id="regAllergies" placeholder="e.g. Penicillin, Sulfa drugs, or NKDA" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
          <button type="button" onclick="closeRegisterPdlModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-emerald-600 hover:bg-emerald-500 text-white">Register & Create Record</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: OBSERVATION LOG -->
  <div id="obsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <h3 class="text-base font-bold text-white">Patient Recovery Observation Log</h3>
        <button onclick="closeObservationModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleObservationSubmit(event)" class="space-y-4">
        <input type="hidden" id="obsRecordId" />
        <div class="p-3 rounded-lg bg-slate-900 text-xs font-bold text-white" id="obsPdlName">--</div>

        <div>
          <label class="text-[11px] text-slate-400">Periodic Observation Notes</label>
          <textarea id="obsNotes" rows="4" required placeholder="Patient vitals stable, compliance with oral meds, resting comfortably..." class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2">
          <button type="button" onclick="closeObservationModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-emerald-600 hover:bg-emerald-500 text-white">Save Observation</button>
        </div>
      </form>
    </div>
  </div>

  {{> printable_modal }}
{{> footer }}

