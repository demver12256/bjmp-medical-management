{{> head }}
<body class="bg-[#0b132b] text-slate-100 min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">

  <!-- ============================================================ -->
  <!-- TOAST NOTIFICATION CONTAINER                                -->
  <!-- ============================================================ -->
  <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none no-print"></div>

  <!-- ============================================================ -->
  <!-- BIOMEDICAL VITAL SPIKE ALARM BANNER (<30ms Telemetry Alert)   -->
  <!-- ============================================================ -->
  <div id="vitalAlarmBanner" class="hidden sticky top-0 z-40 w-full border-b px-4 py-3 bg-red-950/90 text-red-100 backdrop-blur-md transition-all duration-300 no-print">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="flex h-3 w-3 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
        </span>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-red-600 text-white">CRITICAL VITAL SPIKE</span>
          <span id="alarmLatency" class="text-[11px] font-mono text-red-300">18.4 ms latency</span>
        </div>
        <div class="text-sm">
          <span id="alarmPdlInfo" class="font-bold text-white">PDL Patient</span>: 
          <span id="alarmReason" class="text-red-200">Severe Hypertensive Crisis detected.</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="acknowledgeAlarmBtn" class="px-4 py-1.5 text-xs font-bold rounded-lg bg-red-600 hover:bg-red-500 text-white shadow-lg shadow-red-600/40 transition-all flex items-center gap-1.5">
          <span>✓</span> Acknowledge Alert (Physician)
        </button>
      </div>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- TOP NAVIGATION BAR                                           -->
  <!-- ============================================================ -->
  <header class="border-b border-slate-800 bg-[#0f172a]/80 backdrop-blur-md sticky top-0 z-30 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Left: BJMP Emblem & Title -->
      <div class="flex items-center gap-3">
        <img src="/images/bjmp-badge.svg" alt="BJMP Crest" class="w-10 h-10 drop-shadow-md" />
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-1.5">
              <span>BJMP Medical Officer</span>
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40">SYSTEM</span>
            </h1>
          </div>
          <p class="text-[11px] text-slate-400 font-medium">Bureau of Jail Management and Penology • Health Service Directorate</p>
        </div>
      </div>

      <!-- Center: Manila Clock & Live Feed -->
      <div class="hidden md:flex items-center gap-4 text-xs font-mono">
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/60 border border-slate-700/60 text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="headerDigitalClock">09:35:00 PHT</span>
        </div>
        <div class="flex items-center gap-1.5 text-slate-400">
          <span class="text-emerald-400">●</span>
          <span>ACID Relational Storage (Active)</span>
        </div>
      </div>

      <!-- Right: User Chip & Role Switcher -->
      <div class="flex items-center gap-3">
        <!-- User Profile Pill -->
        <div id="currentUserChip" class="hidden sm:flex items-center gap-3 px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700/60">
          <div class="w-8 h-8 rounded-lg bg-blue-600/30 border border-blue-500/40 flex items-center justify-center font-bold text-blue-300 text-xs">
            MD
          </div>
          <div class="text-left">
            <div class="flex items-center gap-2">
              <span id="currentUserName" class="text-xs font-bold text-slate-200">Dr. Maria Elena Santos</span>
              <span id="currentUserRole" class="px-2 py-0.2 text-[10px] font-bold rounded">MedicalOfficer</span>
            </div>
            <div id="currentUserDetail" class="text-[10px] text-slate-400 font-mono">PRC Lic: PRC-MD-0094821</div>
          </div>
        </div>

        <!-- Quick Role Switcher Dropdown Button -->
        <div class="relative group">
          <button class="px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/30 flex items-center gap-1.5 transition-all">
            <span>⚡ Persona Switcher</span>
            <span class="text-[10px]">▼</span>
          </button>
          <div class="absolute right-0 mt-2 w-64 glass-dropdown rounded-xl p-2 hidden group-hover:block transition-all shadow-2xl z-50">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-2 py-1 border-b border-slate-800">
              One-Click Role Switch
            </div>
            <button onclick="quickLogin('doctor')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-blue-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-blue-300">Dr. Maria Santos, MD</span>
              <span class="text-[10px] text-slate-400">Medical Officer (Consult & Prescribe)</span>
            </button>
            <button onclick="quickLogin('nurse')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-emerald-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-emerald-300">Nurse Juan Dela Cruz, RN</span>
              <span class="text-[10px] text-slate-400">Triage Intake & Observations</span>
            </button>
            <button onclick="quickLogin('officer')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-amber-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-amber-300">JO2 Ricardo 'Cardo' Gomez</span>
              <span class="text-[10px] text-slate-400">Escort Dispatcher & Checkup Requests</span>
            </button>
            <button onclick="quickLogin('admin')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-purple-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-purple-300">Alexander Ramos, MIT</span>
              <span class="text-[10px] text-slate-400">System Admin & Immutable Audits</span>
            </button>
            <div class="border-t border-slate-800 mt-1 pt-1">
              <button onclick="handleLogout()" class="w-full text-left px-3 py-1.5 rounded-lg hover:bg-red-600/20 text-xs text-red-400 font-semibold flex items-center gap-1.5">
                <span>🚪</span> Sign Out
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ============================================================ -->
  <!-- MAIN APPLICATION CONTAINER                                   -->
  <!-- ============================================================ -->
  <main id="mainAppContainer" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Role-Based Navigation Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-800 pb-3 mb-6 overflow-x-auto no-print">
      <button id="tabBtn_medical" onclick="switchTab('medical')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border flex items-center gap-2 transition-all bg-blue-600/30 text-blue-400 border-blue-500/50">
        <span>🩺</span>
        <span>Medical Officer Workbench</span>
      </button>

      <button id="tabBtn_nurse" onclick="switchTab('nurse')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>📋</span>
        <span>Nurse Triage Station</span>
      </button>

      <button id="tabBtn_jail" onclick="switchTab('jail')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>🚔</span>
        <span>Jail Escort Dispatcher</span>
      </button>

      <button id="tabBtn_admin" onclick="switchTab('admin')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>🛡️</span>
        <span>System Admin & Audits</span>
      </button>

      <button id="tabBtn_telemetry" onclick="switchTab('telemetry')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>⚡</span>
        <span>Vital Spike Simulator</span>
        <span id="alertCountBadge" class="hidden px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-red-600 text-white">0</span>
      </button>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 1: MEDICAL OFFICER WORKBENCH                             -->
    <!-- ============================================================ -->
    <div id="tabPanel_medical" class="space-y-6">
      <!-- Stat Metric Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="glass-panel p-4 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Pending Evaluations</div>
          <div id="statDocPending" class="text-2xl font-black text-amber-400 mt-1">0</div>
          <div class="text-[11px] text-slate-500 mt-1">Awaiting Doctor round</div>
        </div>
        <div class="glass-panel p-4 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Under Active Treatment</div>
          <div id="statDocTreatments" class="text-2xl font-black text-emerald-400 mt-1">0</div>
          <div class="text-[11px] text-slate-500 mt-1">Prescriptions dispensed</div>
        </div>
        <div class="glass-panel p-4 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Hospital Referrals</div>
          <div id="statDocReferrals" class="text-2xl font-black text-rose-400 mt-1">0</div>
          <div class="text-[11px] text-slate-500 mt-1">External hospital transfers</div>
        </div>
        <div class="glass-panel p-4 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Custody Requests</div>
          <div id="statDocRequests" class="text-2xl font-black text-blue-400 mt-1">0</div>
          <div class="text-[11px] text-slate-500 mt-1">From Jail Escort Officers</div>
        </div>
      </div>

      <!-- Doctor Clinical Queue -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>🩺</span>
              <span>PDL Patients Clinical Queue & Baseline Assessments</span>
            </h2>
            <p class="text-xs text-slate-400">Review triage vitals, medical histories, record formal diagnoses, authorize medication prescriptions or draft hospital referrals.</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="fetchPdls()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-all">
              🔄 Refresh List
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Booking ID</th>
                <th class="px-5 py-3">PDL Name & Demographics</th>
                <th class="px-5 py-3">Baseline History & Allergies</th>
                <th class="px-5 py-3">Case State Machine</th>
                <th class="px-5 py-3">Assigned Facility</th>
                <th class="px-5 py-3 text-right">Clinical Actions</th>
              </tr>
            </thead>
            <tbody id="doctorQueueTableBody" class="divide-y divide-slate-800/60">
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-slate-500">Loading patients from database...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Active Hospital Referrals Tracker -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>🏥</span>
              <span>Hospital Referrals & Escort Missions</span>
            </h3>
            <p class="text-xs text-slate-400">Monitors out-of-facility patient transfers and security escort coordinates per BJMP SOP.</p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Referral ID</th>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Destination Hospital & Reason</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3">Security Escort Detail</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="referralsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="px-6 py-6 text-center text-slate-500">Loading referrals...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Prescriptions List -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>💊</span>
              <span>Authorized Medication Prescriptions</span>
            </h3>
            <p class="text-xs text-slate-400">Prescribed pharmaceuticals, dosage instructions, and dispensing logs.</p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Rx ID</th>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Prescribed Medications & Dosage</th>
                <th class="px-5 py-3">Authorized By</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="prescriptionsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="px-6 py-6 text-center text-slate-500">Loading prescriptions...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 2: NURSE TRIAGE STATION                                  -->
    <!-- ============================================================ -->
    <div id="tabPanel_nurse" class="space-y-6 hidden">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span>📋</span>
            <span>Nurse Triage Station & PDL Registry</span>
          </h2>
          <p class="text-xs text-slate-400">Search PDLs, register new admissions, log preliminary symptoms and record biomedical vital signs.</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="openRegisterPdlModal()" class="px-4 py-2 text-xs font-bold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/30 transition-all flex items-center gap-2">
            <span>+</span> Register New PDL
          </button>
        </div>
      </div>

      <!-- Search Filter -->
      <div class="glass-panel p-4 rounded-xl border border-slate-800 flex items-center gap-3">
        <span class="text-slate-400 text-sm">🔍</span>
        <input type="text" id="nurseSearchInput" oninput="fetchPdls(this.value)" placeholder="Search by booking code (e.g. BJMP-MNL-2026-0104) or full name..." class="flex-1 bg-transparent text-sm text-white placeholder-slate-500 focus:outline-none" />
      </div>

      <!-- Nurse Registry Table -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Booking ID</th>
                <th class="px-5 py-3">Full Name</th>
                <th class="px-5 py-3">Cell / Assigned Facility</th>
                <th class="px-5 py-3">Case Status</th>
                <th class="px-5 py-3 text-right">Nurse Actions</th>
              </tr>
            </thead>
            <tbody id="nurseRegistryTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading PDLs...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 3: JAIL ESCORT DISPATCHER                                -->
    <!-- ============================================================ -->
    <div id="tabPanel_jail" class="space-y-6 hidden">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span>🚔</span>
            <span>Jail Officer Escort Dispatcher & Custody Requests</span>
          </h2>
          <p class="text-xs text-slate-400">Coordinate security escorts, vehicle dispatches, and submit formal checkup requests for PDLs under custody.</p>
        </div>
        <div>
          <button onclick="openNewRequestModal()" class="px-4 py-2 text-xs font-bold rounded-lg bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all flex items-center gap-2">
            <span>+</span> Submit Checkup Request
          </button>
        </div>
      </div>

      <!-- Escort Missions Board -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800">
          <h3 class="text-base font-bold text-white">Active Hospital Escort Transports</h3>
          <p class="text-xs text-slate-400">Escort details assigned by Custody Security Unit for approved hospital referrals.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Referral ID</th>
                <th class="px-5 py-3">PDL Patient & Cell</th>
                <th class="px-5 py-3">Destination Hospital</th>
                <th class="px-5 py-3">Referral Status</th>
                <th class="px-5 py-3">Assigned Vehicle</th>
                <th class="px-5 py-3 text-right">Dispatch Control</th>
              </tr>
            </thead>
            <tbody id="jailEscortBoardBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="px-6 py-6 text-center text-slate-500">Loading escort missions...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Custody Requests Table -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800">
          <h3 class="text-base font-bold text-white">Custody Medical Checkup Requests</h3>
          <p class="text-xs text-slate-400">Requests submitted by Jail Officers to alert Medical Officers of ailments observed in dorms/cells.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Reason for Request</th>
                <th class="px-5 py-3">Priority</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="jailRequestsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading requests...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 4: SYSTEM ADMIN & AUDIT TRAIL                            -->
    <!-- ============================================================ -->
    <div id="tabPanel_admin" class="space-y-6 hidden">
      <div>
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>🛡️</span>
          <span>System Administration & Immutable Audit Trail</span>
        </h2>
        <p class="text-xs text-slate-400">Monitor system uptime, database integrity, officer accounts, and inspect tamper-evident audit logs.</p>
      </div>

      <!-- System Health Diagnostics -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        <div class="glass-panel p-3 rounded-xl border border-slate-800">
          <div class="text-[11px] text-slate-400">Active Accounts</div>
          <div id="adminStatUsers" class="text-xl font-bold text-white mt-0.5">--</div>
        </div>
        <div class="glass-panel p-3 rounded-xl border border-slate-800">
          <div class="text-[11px] text-slate-400">Audit Logs Logged</div>
          <div id="adminStatAudits" class="text-xl font-bold text-purple-400 mt-0.5">--</div>
        </div>
        <div class="glass-panel p-3 rounded-xl border border-slate-800">
          <div class="text-[11px] text-slate-400">Node Runtime</div>
          <div id="adminSystemNode" class="text-xl font-mono text-emerald-400 mt-0.5">--</div>
        </div>
        <div class="glass-panel p-3 rounded-xl border border-slate-800">
          <div class="text-[11px] text-slate-400">RAM (Heap/RSS)</div>
          <div id="adminSystemMem" class="text-xl font-mono text-cyan-400 mt-0.5">--</div>
        </div>
        <div class="glass-panel p-3 rounded-xl border border-slate-800">
          <div class="text-[11px] text-slate-400">System Uptime</div>
          <div id="adminSystemUptime" class="text-xl font-mono text-amber-400 mt-0.5">--</div>
        </div>
      </div>

      <!-- Officer User Accounts Table -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <h3 class="text-base font-bold text-white">Officer & Staff Accounts</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">ID</th>
                <th class="px-5 py-3">Officer Name (Username)</th>
                <th class="px-5 py-3">Role</th>
                <th class="px-5 py-3">Account Status</th>
                <th class="px-5 py-3 text-right">Status Action</th>
              </tr>
            </thead>
            <tbody id="adminUsersTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading accounts...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Immutable Audit Logs -->
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>📜</span>
              <span>Immutable Audit Trail Logs</span>
            </h3>
            <p class="text-xs text-slate-400">Every clinical entry, prescription, referral and role modification is permanently archived.</p>
          </div>
          <button onclick="fetchAuditLogs()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
            🔄 Refresh Logs
          </button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-4 py-3">Timestamp</th>
                <th class="px-4 py-3">Officer / Actor</th>
                <th class="px-4 py-3">Action</th>
                <th class="px-4 py-3">Module</th>
                <th class="px-4 py-3">Details</th>
              </tr>
            </thead>
            <tbody id="auditLogsTableBody" class="divide-y divide-slate-800/60 font-mono text-xs">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading audit trail...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 5: VITAL SPIKE SIMULATOR & TELEMETRY                    -->
    <!-- ============================================================ -->
    <div id="tabPanel_telemetry" class="space-y-6 hidden">
      <div>
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>⚡</span>
          <span>Biomedical Vital Spike Alert Simulation & Telemetry Monitor</span>
        </h2>
        <p class="text-xs text-slate-400">Real-time simulation of medical ward telemetry with timing diagram state machine enforcement.</p>
      </div>

      <!-- ECG Waveform Canvas -->
      <div class="glass-panel p-5 rounded-2xl border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></div>
            <div class="font-bold text-sm text-cyan-300">Continuous Cardiac & Biomedical Telemetry (Lead II)</div>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-400 font-mono">Timing State:</span>
            <span id="monitorStatePill" class="px-2.5 py-1 text-xs font-mono font-bold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              🟢 NORMAL RHYTHM
            </span>
          </div>
        </div>

        <div class="ecg-container rounded-xl w-full h-[140px] flex items-center justify-center">
          <canvas id="ecgCanvas" class="w-full h-full block"></canvas>
        </div>

        <!-- Latency & State Diagnostics -->
        <div class="grid grid-cols-3 gap-3 text-center text-xs font-mono">
          <div class="p-2.5 rounded-lg bg-slate-900/60 border border-slate-800">
            <div class="text-slate-400 text-[10px]">DISPATCH QUEUE LATENCY</div>
            <div id="monitorLatencyEl" class="text-base font-bold text-cyan-400 mt-0.5">&lt; 5 ms</div>
            <div class="text-[10px] text-slate-500">Requirement: &lt; 30 ms</div>
          </div>
          <div class="p-2.5 rounded-lg bg-slate-900/60 border border-slate-800">
            <div class="text-slate-400 text-[10px]">STATE MACHINE PATH</div>
            <div class="text-xs font-bold text-slate-200 mt-1">NORMAL ➔ ALERT ➔ SENDING ➔ SILENT</div>
            <div class="text-[10px] text-slate-500">Timing Diagram Loop</div>
          </div>
          <div class="p-2.5 rounded-lg bg-slate-900/60 border border-slate-800">
            <div class="text-slate-400 text-[10px]">PHYSICIAN NOTIFICATION</div>
            <div class="text-xs font-bold text-amber-400 mt-1">Audible Strobe Alarm Toast</div>
            <div class="text-[10px] text-slate-500">Requires Doctor Acknowledge</div>
          </div>
        </div>
      </div>

      <!-- Trigger Simulation Buttons -->
      <div class="glass-panel p-5 rounded-2xl border border-slate-800 space-y-3">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">Trigger Emergency Vital Spike Scenarios:</h3>
        <p class="text-xs text-slate-400">Click a scenario button to simulate an emergency biomedical spike in the PDL medical ward and observe the alert timing loop.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          <button onclick="triggerSimulation('hypertensive')" class="p-4 rounded-xl bg-gradient-to-br from-red-950/80 to-slate-900 border border-red-500/40 hover:border-red-500 text-left transition-all group">
            <div class="text-xs font-mono font-bold text-red-400 group-hover:text-red-300">🚨 SCENARIO A</div>
            <div class="text-sm font-bold text-white mt-1">Hypertensive Crisis</div>
            <div class="text-xs text-slate-400 mt-0.5">BP: 215/125 mmHg • HR: 135 bpm</div>
            <div class="text-[10px] text-red-300/80 mt-2 font-mono">Immediate stroke risk warning</div>
          </button>

          <button onclick="triggerSimulation('tachycardia')" class="p-4 rounded-xl bg-gradient-to-br from-amber-950/80 to-slate-900 border border-amber-500/40 hover:border-amber-500 text-left transition-all group">
            <div class="text-xs font-mono font-bold text-amber-400 group-hover:text-amber-300">⚡ SCENARIO B</div>
            <div class="text-sm font-bold text-white mt-1">Severe Tachycardia</div>
            <div class="text-xs text-slate-400 mt-0.5">HR: 148 bpm • Temp: 38.2°C</div>
            <div class="text-[10px] text-amber-300/80 mt-2 font-mono">Acute supraventricular tachycardia</div>
          </button>

          <button onclick="triggerSimulation('hypoxia')" class="p-4 rounded-xl bg-gradient-to-br from-purple-950/80 to-slate-900 border border-purple-500/40 hover:border-purple-500 text-left transition-all group">
            <div class="text-xs font-mono font-bold text-purple-400 group-hover:text-purple-300">🫁 SCENARIO C</div>
            <div class="text-sm font-bold text-white mt-1">Hypoxia / Desaturation</div>
            <div class="text-xs text-slate-400 mt-0.5">SpO2: 82% • RR: 32 cpm</div>
            <div class="text-[10px] text-purple-300/80 mt-2 font-mono">Acute respiratory distress</div>
          </button>
        </div>
      </div>
    </div>

  </main>

  <!-- ============================================================ -->
  <!-- MODAL: CLINICAL EXAMINATION & DECISION WORKSPACE             -->
  <!-- ============================================================ -->
  <div id="examModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-2xl my-8">
      <!-- Modal Header -->
      <div class="p-5 border-b border-slate-700/80 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-blue-600/30 border border-blue-500/50 flex items-center justify-center text-lg">
            🩺
          </div>
          <div>
            <h3 class="text-base font-bold text-white">Clinical Examination & Pharmacotherapy Workspace</h3>
            <p class="text-xs text-slate-400">Bureau of Jail Management and Penology • Medical Officer Consultation</p>
          </div>
        </div>
        <button onclick="closeExaminationModal()" class="text-slate-400 hover:text-white text-lg font-bold">✕</button>
      </div>

      <!-- Form Body -->
      <form onsubmit="handleClinicalExamSubmit(event)" class="p-5 space-y-5 overflow-y-auto flex-1">
        <input type="hidden" id="examRecordId" />

        <!-- Patient Demographics Banner -->
        <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-700/80 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <div class="text-[10px] text-slate-400 uppercase font-semibold">Patient Information</div>
            <div id="examModalPdlName" class="font-bold text-sm text-white mt-0.5">Juanito Dela Cruz</div>
            <div id="examModalPdlNumber" class="font-mono text-blue-400">BJMP-MNL-2026-0104</div>
            <div id="examModalPdlCell" class="text-slate-400">Brigada 4 - Cell 12</div>
          </div>
          <div>
            <div class="text-[10px] text-slate-400 uppercase font-semibold">Diagnostic Baseline</div>
            <div class="mt-0.5"><span class="text-slate-400">Hx:</span> <span id="examModalHistory" class="text-slate-200">Hypertension Stage 2</span></div>
            <div><span class="text-slate-400">Allergies:</span> <span id="examModalAllergies" class="text-rose-400 font-bold">Penicillin</span></div>
          </div>
        </div>

        <!-- Vital Signs Entry -->
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-2">1. Current Examination Vital Signs</label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
            <div>
              <span class="text-[10px] text-slate-400">BP (mmHg)</span>
              <input type="text" id="examBp" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="120/80" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">HR (bpm)</span>
              <input type="number" id="examHr" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="76" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">Temp (°C)</span>
              <input type="number" step="0.1" id="examTemp" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="36.8" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">SpO2 (%)</span>
              <input type="number" id="examSpo2" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="98" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">Resp Rate (cpm)</span>
              <input type="number" id="examRr" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="18" />
            </div>
          </div>
        </div>

        <!-- Symptoms & Physical Findings -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase mb-1">2. Chief Complaints & Symptoms</label>
            <textarea id="examSymptoms" rows="3" required placeholder="Patient reported symptoms..." class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500"></textarea>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase mb-1">3. Objective Physical Findings</label>
            <textarea id="examFindings" rows="3" required placeholder="HEENT, Chest/Lungs, CVS, Abdomen findings..." class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500"></textarea>
          </div>
        </div>

        <!-- Formal Diagnosis -->
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">4. Formal Clinical Diagnosis</label>
          <input type="text" id="examDiagnosis" required placeholder="e.g. Essential Hypertension Stage 2; Chronic Bronchial Asthma" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500 font-semibold" />
        </div>

        <!-- Treatment Plan -->
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">5. Clinical Management & Therapy Plan</label>
          <input type="text" id="examTreatmentPlan" placeholder="e.g. Dual anti-hypertensive regimen, low-salt diet, daily BP monitoring" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500" />
        </div>

        <!-- Dynamic Prescription Builder -->
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-slate-300 uppercase">6. Pharmacological Prescriptions (Dynamic Builder)</label>
            <button type="button" onclick="addMedicationRow()" class="px-2.5 py-1 text-xs font-semibold rounded bg-blue-600/30 text-blue-400 hover:bg-blue-600/50 border border-blue-500/40">
              + Add Medication
            </button>
          </div>
          <div id="dynamicMedsContainer" class="space-y-2"></div>
        </div>

        <!-- Hospital Referral Drawer Toggle -->
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="flex items-center gap-2">
            <input type="checkbox" id="enableReferralCheckbox" onchange="toggleReferralDrawer()" class="rounded bg-slate-800 border-slate-700 text-blue-600 focus:ring-0" />
            <label for="enableReferralCheckbox" class="text-xs font-bold text-rose-300 uppercase cursor-pointer">
              Hospitalization Required? (Create Hospital Referral & Notify Escort Security)
            </label>
          </div>

          <div id="referralDrawer" class="hidden space-y-3 pt-2 border-t border-slate-800">
            <div>
              <span class="text-[10px] text-slate-400">Destination Hospital</span>
              <input type="text" id="referralHospital" placeholder="e.g. Philippine General Hospital (PGH) / Jose Reyes Memorial" class="w-full px-3 py-2 text-xs rounded bg-slate-950 border border-slate-700 text-white" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">Reason for Outpatient Referral</span>
              <input type="text" id="referralReason" placeholder="e.g. Urgent specialized pulmonary workup & GeneXpert isolation" class="w-full px-3 py-2 text-xs rounded bg-slate-950 border border-slate-700 text-white" />
            </div>
          </div>
        </div>

        <!-- Submit Footer -->
        <div class="pt-4 border-t border-slate-700/80 flex items-center justify-end gap-3">
          <button type="button" onclick="closeExaminationModal()" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700">Cancel</button>
          <button type="submit" class="px-6 py-2 text-xs font-bold rounded-lg bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/40">
            Commit Clinical Record & Authorize
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL: NURSE TRIAGE INTAKE                                   -->
  <!-- ============================================================ -->
  <div id="triageModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <div>
          <h3 class="text-base font-bold text-white">Triage Intake Station</h3>
          <p class="text-xs text-slate-400">Log vital signs & initial symptoms</p>
        </div>
        <button onclick="closeTriageModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleTriageSubmit(event)" class="space-y-4">
        <input type="hidden" id="triageRecordId" />
        <div class="p-3 rounded-lg bg-slate-900 text-xs">
          <div class="font-bold text-white" id="triagePdlName">--</div>
          <div class="text-slate-400 font-mono" id="triagePdlNumber">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] text-slate-400">Blood Pressure</label>
            <input type="text" id="triageBp" required placeholder="120/80" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Heart Rate (bpm)</label>
            <input type="number" id="triageHr" required placeholder="75" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Temperature (°C)</label>
            <input type="number" step="0.1" id="triageTemp" required placeholder="36.8" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">SpO2 (%)</label>
            <input type="number" id="triageSpo2" required placeholder="98" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div class="col-span-2">
            <label class="text-[11px] text-slate-400">Respiratory Rate (cpm)</label>
            <input type="number" id="triageRr" required placeholder="18" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Preliminary Presenting Symptoms</label>
          <textarea id="triageSymptoms" rows="2" required placeholder="Describe complaints reported by patient during triage..." class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeTriageModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-emerald-600 hover:bg-emerald-500 text-white">Save Triage & Update Queue</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL: REGISTER NEW PDL                                      -->
  <!-- ============================================================ -->
  <div id="regPdlModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-xl w-full p-6 space-y-4 shadow-2xl my-8">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <div>
          <h3 class="text-base font-bold text-white">Register New Person Deprived of Liberty (PDL)</h3>
          <p class="text-xs text-slate-400">Creates booking record & initializes 1:1 Medical Record</p>
        </div>
        <button onclick="closeRegisterPdlModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleRegisterPdlSubmit(event)" class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] text-slate-400">Booking Number</label>
            <input type="text" id="regPdlNumber" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Full Name</label>
            <input type="text" id="regFullName" required placeholder="e.g. Manuel 'Manny' Reyes" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Date of Birth</label>
            <input type="date" id="regDob" required value="1985-05-10" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Admission Date</label>
            <input type="date" id="regAdmissionDate" required value="2026-10-30" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Assigned Facility</label>
            <select id="regFacility" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white">
              <option value="Manila City Jail Male Dormitory">Manila City Jail Male Dormitory</option>
              <option value="Quezon City Jail Male Dormitory">Quezon City Jail Male Dormitory</option>
              <option value="Pasig City Jail Male Dormitory">Pasig City Jail Male Dormitory</option>
            </select>
          </div>
          <div>
            <label class="text-[11px] text-slate-400">Cell / Brigada Number</label>
            <input type="text" id="regCell" required placeholder="e.g. Brigada 3 - Cell 08" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
          </div>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Initial Medical History / Chronic Conditions</label>
          <textarea id="regHistory" rows="2" placeholder="Chronic ailments, surgeries, prior hospitalizations..." class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Known Drug Allergies</label>
          <input type="text" id="regAllergies" placeholder="e.g. Penicillin, Sulfa drugs, or NKDA" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white" />
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
          <button type="button" onclick="closeRegisterPdlModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-emerald-600 hover:bg-emerald-500 text-white">Register & Create Record</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL: ESCORT DISPATCH (JAIL OFFICER)                        -->
  <!-- ============================================================ -->
  <div id="escortModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <div>
          <h3 class="text-base font-bold text-white">Hospital Escort Dispatch Detail</h3>
          <p class="text-xs text-slate-400">Custody transport & security logistics</p>
        </div>
        <button onclick="closeEscortModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleEscortSubmit(event)" class="space-y-4">
        <input type="hidden" id="escortReferralId" />
        <div class="p-3 rounded-lg bg-slate-900 text-xs">
          <div class="font-bold text-blue-400" id="escortModalRefNum">--</div>
          <div class="text-slate-300" id="escortModalDest">--</div>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Referral Status Progression</label>
          <select id="escortStatusSelect" class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white font-semibold">
            <option value="Drafted">Drafted</option>
            <option value="Escort Requested">Escort Requested</option>
            <option value="Warden Approved">Warden Approved</option>
            <option value="Outpatient Referred">Outpatient Referred</option>
            <option value="Discharged">Discharged (Returned to Facility)</option>
          </select>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Assigned Vehicle Plate Number</label>
          <input type="text" id="escortVehiclePlate" placeholder="e.g. SAB-4412 (BJMP Escort Van 02)" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Security Restraints & Escort Personnel Notes</label>
          <textarea id="escortNotes" rows="2" placeholder="Armed detail personnel, restraints protocol..." class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeEscortModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-amber-600 hover:bg-amber-500 text-white">Save Dispatch Detail</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL: NEW CHECKUP REQUEST                                   -->
  <!-- ============================================================ -->
  <div id="newRequestModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <h3 class="text-base font-bold text-white">Submit Medical Checkup Request</h3>
        <button onclick="closeNewRequestModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleNewRequestSubmit(event)" class="space-y-4">
        <div>
          <label class="text-[11px] text-slate-400">Select PDL under Custody</label>
          <select id="requestPdlSelect" required class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono">
            <option value="">-- Choose PDL --</option>
          </select>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Priority Level</label>
          <select id="requestPriority" class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white font-bold">
            <option value="Normal">Normal Priority</option>
            <option value="Urgent">Urgent Priority (Immediate Physician Attention)</option>
          </select>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Reason for Request / Symptoms Observed</label>
          <textarea id="requestReason" rows="3" required placeholder="Describe symptoms or reasons observed during cell inspection..." class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeNewRequestModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-blue-600 hover:bg-blue-500 text-white">Submit Request</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL: OBSERVATION LOG                                       -->
  <!-- ============================================================ -->
  <div id="obsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <h3 class="text-base font-bold text-white">Patient Recovery Observation Log</h3>
        <button onclick="closeObservationModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleObservationSubmit(event)" class="space-y-4">
        <input type="hidden" id="obsRecordId" />
        <div class="p-3 rounded-lg bg-slate-900 text-xs font-bold text-white" id="obsPdlName">--</div>

        <div>
          <label class="text-[11px] text-slate-400">Periodic Observation Notes</label>
          <textarea id="obsNotes" rows="4" required placeholder="Patient vitals stable, compliance with oral meds, resting comfortably..." class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2">
          <button type="button" onclick="closeObservationModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-emerald-600 hover:bg-emerald-500 text-white">Save Observation</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL: PRINTABLE CLINICAL ABSTRACT                           -->
  <!-- ============================================================ -->
  <div id="printableModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md overflow-y-auto">
    <div id="printableModalContainer" class="bg-white text-black max-w-3xl w-full rounded-2xl shadow-2xl overflow-hidden my-8">
      <div class="p-4 border-b border-gray-300 flex items-center justify-between bg-gray-100 no-print">
        <div class="font-bold text-sm text-gray-800">Print Preview: Official BJMP Clinical Abstract</div>
        <div class="flex items-center gap-2">
          <button onclick="triggerPrint()" class="px-4 py-1.5 text-xs font-bold rounded-lg bg-blue-700 hover:bg-blue-600 text-white flex items-center gap-1.5 shadow">
            🖨️ Print / Save as PDF
          </button>
          <button onclick="closePrintableAbstract()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-300 hover:bg-gray-400 text-gray-800">
            Close
          </button>
        </div>
      </div>
      <div id="printableAbstractContent" class="p-2"></div>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL: AUTHENTICATION / LOGIN                                -->
  <!-- ============================================================ -->
  <div id="authModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md no-print">
    <div class="glass-panel border border-slate-700 rounded-3xl max-w-md w-full p-8 space-y-6 shadow-2xl text-center">
      <div class="flex flex-col items-center">
        <img src="/images/bjmp-badge.svg" alt="BJMP Insignia" class="w-16 h-16 drop-shadow-xl mb-3" />
        <h2 class="text-xl font-black tracking-tight text-white">BJMP Medical Officer</h2>
        <div class="text-xs uppercase tracking-widest text-amber-400 font-bold mt-0.5">Management System</div>
        <p class="text-xs text-slate-400 mt-1">Bureau of Jail Management and Penology • DILG</p>
      </div>

      <div class="p-3 rounded-xl bg-blue-950/40 border border-blue-500/30 text-left text-xs text-slate-300 space-y-2">
        <div class="font-bold text-blue-300 flex items-center gap-1.5">
          <span>⚡</span> Select a Demo Persona to Sign In:
        </div>
        <div class="grid grid-cols-2 gap-2 pt-1">
          <button onclick="quickLogin('doctor')" class="p-2 rounded-lg bg-blue-900/60 hover:bg-blue-800/80 border border-blue-500/40 text-left transition-all">
            <div class="font-bold text-white text-[11px]">Dr. Santos</div>
            <div class="text-[9px] text-blue-300">Medical Officer</div>
          </button>
          <button onclick="quickLogin('nurse')" class="p-2 rounded-lg bg-emerald-900/60 hover:bg-emerald-800/80 border border-emerald-500/40 text-left transition-all">
            <div class="font-bold text-white text-[11px]">Nurse Cruz</div>
            <div class="text-[9px] text-emerald-300">Health Personnel</div>
          </button>
          <button onclick="quickLogin('officer')" class="p-2 rounded-lg bg-amber-900/60 hover:bg-amber-800/80 border border-amber-500/40 text-left transition-all">
            <div class="font-bold text-white text-[11px]">JO2 Gomez</div>
            <div class="text-[9px] text-amber-300">Jail Escort Officer</div>
          </button>
          <button onclick="quickLogin('admin')" class="p-2 rounded-lg bg-purple-900/60 hover:bg-purple-800/80 border border-purple-500/40 text-left transition-all">
            <div class="font-bold text-white text-[11px]">Admin Ramos</div>
            <div class="text-[9px] text-purple-300">System Admin</div>
          </button>
        </div>
      </div>

      <div class="relative flex items-center justify-center">
        <div class="border-t border-slate-800 w-full"></div>
        <span class="bg-[#1e293b] px-3 text-[10px] text-slate-500 font-mono uppercase tracking-wider absolute">or login with credentials</span>
      </div>

      <form onsubmit="handleCustomLogin(event)" class="space-y-3 text-left">
        <div>
          <label class="text-[11px] text-slate-400">Username</label>
          <input type="text" id="loginUsername" required placeholder="dr.santos" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white font-mono" />
        </div>
        <div>
          <label class="text-[11px] text-slate-400">Password</label>
          <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white" />
        </div>
        <button type="submit" class="w-full py-2.5 text-xs font-bold rounded-xl bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all mt-2">
          Authenticate & Launch System
        </button>
      </form>
    </div>
  </div>

{{> footer }}