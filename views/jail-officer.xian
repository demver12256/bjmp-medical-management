{{> head }}
<body class="bg-[#0b132b] text-slate-100 min-h-screen flex flex-col selection:bg-amber-600 selection:text-white">

  {{> navbar }}

  <!-- ============================================================ -->
  <!-- JAIL OFFICER DEDICATED WORKSPACE (/jail-officer)             -->
  <!-- ============================================================ -->
  <main id="mainAppContainer" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Jail Officer Role Banner -->
    <div class="mb-6 p-4 rounded-2xl bg-gradient-to-r from-amber-950/70 via-slate-900/80 to-slate-900/80 border border-amber-500/30 flex flex-wrap items-center justify-between gap-4 no-print">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-amber-600/20 border border-amber-500/40 flex items-center justify-center text-2xl">
          🚔
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white">Jail Officer Escort Dispatcher & Custody Checkup Portal</h2>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">JailOfficer Role</span>
          </div>
          <p class="text-xs text-slate-400">Coordinate armed hospital escort transports, assign BJMP vehicles, and submit urgent custody checkup requests.</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="openNewRequestModal()" class="px-4 py-2 text-xs font-bold rounded-xl bg-amber-600 hover:bg-amber-500 text-white shadow-lg shadow-amber-600/30 transition-all flex items-center gap-1.5">
          <span>+</span> Submit Checkup Request
        </button>
      </div>
    </div>

    <!-- Jail Officer Stat Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 no-print">
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Active Escort Missions</div>
        <div id="statDocReferrals" class="text-2xl font-black text-amber-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Hospital transfers in progress</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Pending Checkup Requests</div>
        <div id="statDocRequests" class="text-2xl font-black text-rose-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Awaiting clinic evaluation</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Reviewed Requests</div>
        <div id="statJailReviewedReqs" class="text-2xl font-black text-emerald-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Processed by Medical Officer</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">PDLs Under Custody</div>
        <div id="statNurseTotalPdls" class="text-2xl font-black text-blue-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Assigned across dormitories</div>
      </div>
    </div>

    <!-- Jail Officer Internal Section Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-800 pb-3 mb-6 overflow-x-auto no-print">
      <button id="tabBtn_jail" onclick="switchTab('jail')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border flex items-center gap-2 transition-all bg-blue-600/30 text-blue-400 border-blue-500/50">
        <span>🚔</span>
        <span>Hospital Escort Missions</span>
      </button>

      <button id="tabBtn_requests" onclick="switchTab('requests')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>📨</span>
        <span>Custody Checkup Requests</span>
      </button>

      <button id="tabBtn_directory" onclick="switchTab('directory')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>🏢</span>
        <span>Dormitory & Cell Roster</span>
      </button>
    </div>

    <!-- SECTION 1: ESCORT MISSIONS BOARD -->
    <div id="tabPanel_jail" class="space-y-6">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white">Active Hospital Escort Transports</h3>
            <p class="text-xs text-slate-400">Escort details assigned by Custody Security Unit for approved hospital referrals.</p>
          </div>
          <button onclick="fetchReferrals()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
            🔄 Refresh Board
          </button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Referral ID</th>
                <th class="px-5 py-3">PDL Patient & Cell</th>
                <th class="px-5 py-3">Destination Hospital</th>
                <th class="px-5 py-3">Referral Status</th>
                <th class="px-5 py-3">Assigned Vehicle</th>
                <th class="px-5 py-3 text-right">Dispatch Control</th>
              </tr>
            </thead>
            <tbody id="jailEscortBoardBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="px-6 py-6 text-center text-slate-500">Loading escort missions...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 2: CUSTODY CHECKUP REQUESTS -->
    <div id="tabPanel_requests" class="space-y-6 hidden">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white">Custody Medical Checkup Requests</h3>
            <p class="text-xs text-slate-400">Requests submitted by Jail Officers to alert Medical Officers of ailments observed in dorms/cells.</p>
          </div>
          <button onclick="openNewRequestModal()" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-amber-600 hover:bg-amber-500 text-white">
            + New Request
          </button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Reason for Request</th>
                <th class="px-5 py-3">Priority</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="jailRequestsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading requests...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 3: CUSTODY DORMITORY ROSTER -->
    <div id="tabPanel_directory" class="space-y-6 hidden">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="text-base font-bold text-white">Custody PDL Dormitory & Cell Roster</h3>
            <p class="text-xs text-slate-400">Quick reference for PDL cell location and current medical clearance status.</p>
          </div>
          <input type="text" oninput="fetchPdls(this.value)" placeholder="Search PDL name or cell..." class="px-3 py-1.5 text-xs rounded-lg bg-slate-900 border border-slate-700 text-white" />
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Booking Number</th>
                <th class="px-5 py-3">Full Name</th>
                <th class="px-5 py-3">Cell / Brigada</th>
                <th class="px-5 py-3">Facility</th>
                <th class="px-5 py-3">Medical Case Status</th>
              </tr>
            </thead>
            <tbody id="jailDirectoryTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading custody roster...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>

  <!-- MODAL: ESCORT DISPATCH (JAIL OFFICER) -->
  <div id="escortModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <div>
          <h3 class="text-base font-bold text-white">Hospital Escort Dispatch Detail</h3>
          <p class="text-xs text-slate-400">Custody transport & security logistics</p>
        </div>
        <button onclick="closeEscortModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleEscortSubmit(event)" class="space-y-4">
        <input type="hidden" id="escortReferralId" />
        <div class="p-3 rounded-lg bg-slate-900 text-xs">
          <div class="font-bold text-blue-400" id="escortModalRefNum">--</div>
          <div class="text-slate-300" id="escortModalDest">--</div>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Referral Status Progression</label>
          <select id="escortStatusSelect" class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white font-semibold">
            <option value="Drafted">Drafted</option>
            <option value="Escort Requested">Escort Requested</option>
            <option value="Warden Approved">Warden Approved</option>
            <option value="Outpatient Referred">Outpatient Referred</option>
            <option value="Discharged">Discharged (Returned to Facility)</option>
          </select>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Assigned Vehicle Plate Number</label>
          <input type="text" id="escortVehiclePlate" placeholder="e.g. SAB-4412 (BJMP Escort Van 02)" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Security Restraints & Escort Personnel Notes</label>
          <textarea id="escortNotes" rows="2" placeholder="Armed detail personnel, restraints protocol..." class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeEscortModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-amber-600 hover:bg-amber-500 text-white">Save Dispatch Detail</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: NEW CHECKUP REQUEST -->
  <div id="newRequestModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <h3 class="text-base font-bold text-white">Submit Medical Checkup Request</h3>
        <button onclick="closeNewRequestModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleNewRequestSubmit(event)" class="space-y-4">
        <div>
          <label class="text-[11px] text-slate-400">Select PDL under Custody</label>
          <select id="requestPdlSelect" required class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono">
            <option value="">-- Choose PDL --</option>
          </select>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Priority Level</label>
          <select id="requestPriority" class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white font-bold">
            <option value="Normal">Normal Priority</option>
            <option value="Urgent">Urgent Priority (Immediate Physician Attention)</option>
          </select>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Reason for Request / Symptoms Observed</label>
          <textarea id="requestReason" rows="3" required placeholder="Describe symptoms or reasons observed during cell inspection..." class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeNewRequestModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-amber-600 hover:bg-amber-500 text-white">Submit Request</button>
        </div>
      </form>
    </div>
  </div>

{{> footer }}

