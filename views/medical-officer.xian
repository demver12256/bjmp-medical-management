{{> head }}
<body class="bg-[#0b132b] text-slate-100 min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">

  {{> navbar }}

  <!-- ============================================================ -->
  <!-- MEDICAL OFFICER DEDICATED WORKSPACE (/medical-officer)       -->
  <!-- ============================================================ -->
  <main id="mainAppContainer" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Medical Officer Role Banner -->
    <div class="mb-6 p-4 rounded-2xl bg-gradient-to-r from-blue-950/70 via-slate-900/80 to-slate-900/80 border border-blue-500/30 flex flex-wrap items-center justify-between gap-4 no-print">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-2xl">
          🩺
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white">Physician Clinical Consultation & Decision Center</h2>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30">MedicalOfficer Role</span>
          </div>
          <p class="text-xs text-slate-400">Conduct full physical examinations, authorize pharmacotherapy prescriptions, and issue external hospital referrals.</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="fetchPdls(); fetchReferrals(); fetchPrescriptions(); fetchRequests();" class="px-3.5 py-2 text-xs font-bold rounded-xl bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/20 transition-all">
          🔄 Sync Clinical Queue
        </button>
      </div>
    </div>

    <!-- Stat Metric Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 no-print">
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Pending Evaluations</div>
        <div id="statDocPending" class="text-2xl font-black text-amber-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Awaiting Doctor examination</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Under Active Treatment</div>
        <div id="statDocTreatments" class="text-2xl font-black text-emerald-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">Active pharmacological regimens</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Hospital Referrals</div>
        <div id="statDocReferrals" class="text-2xl font-black text-rose-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">External hospital transfers</div>
      </div>
      <div class="glass-panel p-4 rounded-xl border border-slate-800">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Custody Requests</div>
        <div id="statDocRequests" class="text-2xl font-black text-blue-400 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-1">From Jail Escort Officers</div>
      </div>
    </div>

    <!-- Medical Officer Internal Section Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-800 pb-3 mb-6 overflow-x-auto no-print">
      <button id="tabBtn_medical" onclick="switchTab('medical')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border flex items-center gap-2 transition-all bg-blue-600/30 text-blue-400 border-blue-500/50">
        <span>🩺</span>
        <span>Clinical Queue & Consultations</span>
      </button>

      <button id="tabBtn_referrals" onclick="switchTab('referrals')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>🏥</span>
        <span>Hospital Referrals</span>
      </button>

      <button id="tabBtn_prescriptions" onclick="switchTab('prescriptions')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>💊</span>
        <span>Authorized Prescriptions</span>
      </button>

      <button id="tabBtn_requests" onclick="switchTab('requests')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>📨</span>
        <span>Custody Checkup Requests</span>
      </button>

      <button id="tabBtn_telemetry" onclick="switchTab('telemetry')" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-lg border border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-all">
        <span>⚡</span>
        <span>Vital Spike Telemetry</span>
        <span id="alertCountBadge" class="hidden px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-red-600 text-white">0</span>
      </button>
    </div>

    <!-- SECTION 1: CLINICAL QUEUE -->
    <div id="tabPanel_medical" class="space-y-6">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>🩺</span>
              <span>PDL Patients Clinical Queue & Baseline Assessments</span>
            </h2>
            <p class="text-xs text-slate-400">Review triage vitals, medical histories, record formal diagnoses, authorize medication prescriptions or draft hospital referrals.</p>
          </div>
          <div class="flex items-center gap-2">
            <input type="text" oninput="fetchPdls(this.value)" placeholder="Search patient name or booking ID..." class="px-3 py-1.5 text-xs rounded-lg bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-blue-500" />
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Booking ID</th>
                <th class="px-5 py-3">PDL Name & Demographics</th>
                <th class="px-5 py-3">Baseline History & Allergies</th>
                <th class="px-5 py-3">Case State Machine</th>
                <th class="px-5 py-3">Assigned Facility</th>
                <th class="px-5 py-3 text-right">Physician Actions</th>
              </tr>
            </thead>
            <tbody id="doctorQueueTableBody" class="divide-y divide-slate-800/60">
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-slate-500">Loading patients from database...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 2: HOSPITAL REFERRALS -->
    <div id="tabPanel_referrals" class="space-y-6 hidden">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>🏥</span>
              <span>Hospital Referrals & Escort Missions</span>
            </h3>
            <p class="text-xs text-slate-400">Monitors out-of-facility patient transfers and security escort coordinates per BJMP SOP.</p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Referral ID</th>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Destination Hospital & Reason</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3">Security Escort Detail</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="referralsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="px-6 py-6 text-center text-slate-500">Loading referrals...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 3: PRESCRIPTIONS -->
    <div id="tabPanel_prescriptions" class="space-y-6 hidden">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>💊</span>
              <span>Authorized Medication Prescriptions</span>
            </h3>
            <p class="text-xs text-slate-400">Prescribed pharmaceuticals, dosage instructions, and dispensing logs.</p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">Rx ID</th>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Prescribed Medications & Dosage</th>
                <th class="px-5 py-3">Authorized By</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="prescriptionsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="px-6 py-6 text-center text-slate-500">Loading prescriptions...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 4: CUSTODY CHECKUP REQUESTS -->
    <div id="tabPanel_requests" class="space-y-6 hidden">
      <div class="glass-panel rounded-xl border border-slate-800 overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-800">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span>📨</span>
            <span>Custody Medical Checkup Requests</span>
          </h3>
          <p class="text-xs text-slate-400">Requests submitted by Jail Officers for PDLs exhibiting symptoms during dorm inspections.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="px-5 py-3">PDL Patient</th>
                <th class="px-5 py-3">Reason for Request</th>
                <th class="px-5 py-3">Priority</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Physician Action</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody" class="divide-y divide-slate-800/60">
              <tr><td colspan="5" class="px-6 py-6 text-center text-slate-500">Loading requests...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SECTION 5: TELEMETRY -->
    {{> telemetry }}

  </main>

  <!-- ============================================================ -->
  <!-- MODAL: CLINICAL EXAMINATION & DECISION WORKSPACE             -->
  <!-- ============================================================ -->
  <div id="examModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-2xl my-8">
      <div class="p-5 border-b border-slate-700/80 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-blue-600/30 border border-blue-500/50 flex items-center justify-center text-lg">
            🩺
          </div>
          <div>
            <h3 class="text-base font-bold text-white">Clinical Examination & Pharmacotherapy Workspace</h3>
            <p class="text-xs text-slate-400">Bureau of Jail Management and Penology • Medical Officer Consultation</p>
          </div>
        </div>
        <button onclick="closeExaminationModal()" class="text-slate-400 hover:text-white text-lg font-bold">✕</button>
      </div>

      <form onsubmit="handleClinicalExamSubmit(event)" class="p-5 space-y-5 overflow-y-auto flex-1">
        <input type="hidden" id="examRecordId" />

        <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-700/80 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <div class="text-[10px] text-slate-400 uppercase font-semibold">Patient Information</div>
            <div id="examModalPdlName" class="font-bold text-sm text-white mt-0.5">Juanito Dela Cruz</div>
            <div id="examModalPdlNumber" class="font-mono text-blue-400">BJMP-MNL-2026-0104</div>
            <div id="examModalPdlCell" class="text-slate-400">Brigada 4 - Cell 12</div>
          </div>
          <div>
            <div class="text-[10px] text-slate-400 uppercase font-semibold">Diagnostic Baseline</div>
            <div class="mt-0.5"><span class="text-slate-400">Hx:</span> <span id="examModalHistory" class="text-slate-200">Hypertension Stage 2</span></div>
            <div><span class="text-slate-400">Allergies:</span> <span id="examModalAllergies" class="text-rose-400 font-bold">Penicillin</span></div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-2">1. Current Examination Vital Signs</label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
            <div>
              <span class="text-[10px] text-slate-400">BP (mmHg)</span>
              <input type="text" id="examBp" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="120/80" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">HR (bpm)</span>
              <input type="number" id="examHr" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="76" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">Temp (°C)</span>
              <input type="number" step="0.1" id="examTemp" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="36.8" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">SpO2 (%)</span>
              <input type="number" id="examSpo2" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="98" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">Resp Rate (cpm)</span>
              <input type="number" id="examRr" required class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" placeholder="18" />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase mb-1">2. Chief Complaints & Symptoms</label>
            <textarea id="examSymptoms" rows="3" required placeholder="Patient reported symptoms..." class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500"></textarea>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase mb-1">3. Objective Physical Findings</label>
            <textarea id="examFindings" rows="3" required placeholder="HEENT, Chest/Lungs, CVS, Abdomen findings..." class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500"></textarea>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">4. Formal Clinical Diagnosis</label>
          <input type="text" id="examDiagnosis" required placeholder="e.g. Essential Hypertension Stage 2; Chronic Bronchial Asthma" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500 font-semibold" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">5. Clinical Management & Therapy Plan</label>
          <input type="text" id="examTreatmentPlan" placeholder="e.g. Dual anti-hypertensive regimen, low-salt diet, daily BP monitoring" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-blue-500" />
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-slate-300 uppercase">6. Pharmacological Prescriptions (Dynamic Builder)</label>
            <button type="button" onclick="addMedicationRow()" class="px-2.5 py-1 text-xs font-semibold rounded bg-blue-600/30 text-blue-400 hover:bg-blue-600/50 border border-blue-500/40">
              + Add Medication
            </button>
          </div>
          <div id="dynamicMedsContainer" class="space-y-2"></div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="flex items-center gap-2">
            <input type="checkbox" id="enableReferralCheckbox" onchange="toggleReferralDrawer()" class="rounded bg-slate-800 border-slate-700 text-blue-600 focus:ring-0" />
            <label for="enableReferralCheckbox" class="text-xs font-bold text-rose-300 uppercase cursor-pointer">
              Hospitalization Required? (Create Hospital Referral & Notify Escort Security)
            </label>
          </div>

          <div id="referralDrawer" class="hidden space-y-3 pt-2 border-t border-slate-800">
            <div>
              <span class="text-[10px] text-slate-400">Destination Hospital</span>
              <input type="text" id="referralHospital" placeholder="e.g. Philippine General Hospital (PGH) / Jose Reyes Memorial" class="w-full px-3 py-2 text-xs rounded bg-slate-950 border border-slate-700 text-white" />
            </div>
            <div>
              <span class="text-[10px] text-slate-400">Reason for Outpatient Referral</span>
              <input type="text" id="referralReason" placeholder="e.g. Urgent specialized pulmonary workup & GeneXpert isolation" class="w-full px-3 py-2 text-xs rounded bg-slate-950 border border-slate-700 text-white" />
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-700/80 flex items-center justify-end gap-3">
          <button type="button" onclick="closeExaminationModal()" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700">Cancel</button>
          <button type="submit" class="px-6 py-2 text-xs font-bold rounded-lg bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/40">
            Commit Clinical Record & Authorize
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: ESCORT / REFERRAL STATUS UPDATE -->
  <div id="escortModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm no-print">
    <div class="glass-panel border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <div>
          <h3 class="text-base font-bold text-white">Hospital Referral & Escort Status</h3>
          <p class="text-xs text-slate-400">Update referral progression or discharge status</p>
        </div>
        <button onclick="closeEscortModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form onsubmit="handleEscortSubmit(event)" class="space-y-4">
        <input type="hidden" id="escortReferralId" />
        <div class="p-3 rounded-lg bg-slate-900 text-xs">
          <div class="font-bold text-blue-400" id="escortModalRefNum">--</div>
          <div class="text-slate-300" id="escortModalDest">--</div>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Referral Status Progression</label>
          <select id="escortStatusSelect" class="w-full px-3 py-2 text-xs rounded bg-slate-900 border border-slate-700 text-white font-semibold">
            <option value="Drafted">Drafted</option>
            <option value="Escort Requested">Escort Requested</option>
            <option value="Warden Approved">Warden Approved</option>
            <option value="Outpatient Referred">Outpatient Referred</option>
            <option value="Discharged">Discharged (Returned to Facility)</option>
          </select>
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Assigned Vehicle Plate Number</label>
          <input type="text" id="escortVehiclePlate" placeholder="e.g. SAB-4412 (BJMP Escort Van 02)" class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white font-mono" />
        </div>

        <div>
          <label class="text-[11px] text-slate-400">Security Restraints & Clinical Notes</label>
          <textarea id="escortNotes" rows="2" placeholder="Notes on transfer or discharge..." class="w-full px-3 py-1.5 text-xs rounded bg-slate-900 border border-slate-700 text-white"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeEscortModal()" class="px-4 py-2 text-xs rounded bg-slate-800 text-slate-300">Cancel</button>
          <button type="submit" class="px-5 py-2 text-xs font-bold rounded bg-blue-600 hover:bg-blue-500 text-white">Update Referral</button>
        </div>
      </form>
    </div>
  </div>

  {{> printable_modal }}
{{> footer }}

