  <!-- ============================================================ -->
  <!-- TOAST NOTIFICATION CONTAINER                                -->
  <!-- ============================================================ -->
  <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none no-print"></div>

  <!-- ============================================================ -->
  <!-- BIOMEDICAL VITAL SPIKE ALARM BANNER (<30ms Telemetry Alert)   -->
  <!-- ============================================================ -->
  <div id="vitalAlarmBanner" class="hidden sticky top-0 z-40 w-full border-b px-4 py-3 bg-red-950/90 text-red-100 backdrop-blur-md transition-all duration-300 no-print">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="flex h-3 w-3 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
        </span>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-red-600 text-white">CRITICAL VITAL SPIKE</span>
          <span id="alarmLatency" class="text-[11px] font-mono text-red-300">18.4 ms latency</span>
        </div>
        <div class="text-sm">
          <span id="alarmPdlInfo" class="font-bold text-white">PDL Patient</span>: 
          <span id="alarmReason" class="text-red-200">Severe Hypertensive Crisis detected.</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="acknowledgeAlarmBtn" class="px-4 py-1.5 text-xs font-bold rounded-lg bg-red-600 hover:bg-red-500 text-white shadow-lg shadow-red-600/40 transition-all flex items-center gap-1.5">
          <span>✓</span> Acknowledge Alert
        </button>
      </div>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- TOP NAVIGATION BAR                                           -->
  <!-- ============================================================ -->
  <header class="border-b border-slate-800 bg-[#0f172a]/80 backdrop-blur-md sticky top-0 z-30 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Left: BJMP Emblem & Role Portal Title -->
      <div class="flex items-center gap-3">
        <img src="/images/bjmp-badge.svg" alt="BJMP Crest" class="w-10 h-10 drop-shadow-md" />
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-2">
              <span>{{ portalTitle }}</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded border {{ portalBadgeClass }}">{{ portalBadge }}</span>
            </h1>
          </div>
          <p class="text-[11px] text-slate-400 font-medium">Bureau of Jail Management and Penology • Health Service Directorate</p>
        </div>
      </div>

      <!-- Center: Manila Clock & Live Feed -->
      <div class="hidden lg:flex items-center gap-4 text-xs font-mono">
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/60 border border-slate-700/60 text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="headerDigitalClock">09:35:00 PHT</span>
        </div>
        <div class="flex items-center gap-1.5 text-slate-400">
          <span class="text-emerald-400">●</span>
          <span>ACID Relational Storage</span>
        </div>
      </div>

      <!-- Right: User Chip & Role Switcher -->
      <div class="flex items-center gap-3">
        <!-- User Profile Pill -->
        <div id="currentUserChip" class="hidden sm:flex items-center gap-3 px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700/60">
          <div id="currentUserAvatar" class="w-8 h-8 rounded-lg bg-blue-600/30 border border-blue-500/40 flex items-center justify-center font-bold text-blue-300 text-xs">
            MD
          </div>
          <div class="text-left">
            <div class="flex items-center gap-2">
              <span id="currentUserName" class="text-xs font-bold text-slate-200">Loading User...</span>
              <span id="currentUserRole" class="px-2 py-0.5 text-[10px] font-bold rounded">--</span>
            </div>
            <div id="currentUserDetail" class="text-[10px] text-slate-400 font-mono">Verifying credentials...</div>
          </div>
        </div>

        <!-- Quick Role Switcher Dropdown Button -->
        <div class="relative group">
          <button class="px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/30 flex items-center gap-1.5 transition-all">
            <span>⚡ Switch Role Page</span>
            <span class="text-[10px]">▼</span>
          </button>
          <div class="absolute right-0 mt-2 w-64 glass-dropdown rounded-xl p-2 hidden group-hover:block transition-all shadow-2xl z-50">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-2 py-1 border-b border-slate-800">
              Dedicated Role Portals
            </div>
            <button onclick="quickLogin('doctor')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-blue-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-blue-300">🩺 Dr. Maria Santos, MD</span>
              <span class="text-[10px] text-slate-400">/medical-officer • Consult & Prescribe</span>
            </button>
            <button onclick="quickLogin('nurse')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-emerald-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-emerald-300">📋 Nurse Juan Dela Cruz, RN</span>
              <span class="text-[10px] text-slate-400">/nurse • Triage & Pharmacy</span>
            </button>
            <button onclick="quickLogin('officer')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-amber-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-amber-300">🚔 JO2 Ricardo 'Cardo' Gomez</span>
              <span class="text-[10px] text-slate-400">/jail-officer • Escort & Custody</span>
            </button>
            <button onclick="quickLogin('admin')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-purple-600/20 text-xs text-slate-200 flex flex-col transition-colors">
              <span class="font-bold text-purple-300">🛡️ Alexander Ramos, MIT</span>
              <span class="text-[10px] text-slate-400">/admin • System Admin & Audits</span>
            </button>
            <div class="border-t border-slate-800 mt-1 pt-1">
              <button onclick="handleLogout()" class="w-full text-left px-3 py-1.5 rounded-lg hover:bg-red-600/20 text-xs text-red-400 font-semibold flex items-center gap-1.5">
                <span>🚪</span> Sign Out to Login Portal
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

