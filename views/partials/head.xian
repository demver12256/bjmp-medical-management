<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - BJMP Health Service Directorate</title>
  <link rel="icon" type="image/svg+xml" href="/images/bjmp-badge.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    window.PAGE_ROLE = "{{ pageRole }}";
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            bjmp: {
              navy: '#0b132b',
              surface: '#1c2541',
              card: '#1e293b',
              gold: '#f59e0b',
              cyan: '#06b6d4',
              crimson: '#ef4444',
              emerald: '#10b981'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/app.css">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
